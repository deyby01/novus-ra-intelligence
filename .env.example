# ============================================================
# Novus RA Intelligence — environment variable template
# Copy these values into `.env` and fill in the real ones.
# `.env` is git-ignored and must NEVER be committed.
# ============================================================

# --- Django ---
DJANGO_ENV=development
# REQUIRED — replace the placeholder with a unique, high-entropy value.
# It doubles as the JWT signing key; production REFUSES to boot with the
# placeholder or a key shorter than 50 chars (see config/settings/prod.py).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Browser origins allowed to call the API (comma-separated), for production.
# Local dev already allows the Vite server via config/settings/dev.py.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# --- PostgreSQL ---
# POSTGRES_HOST=db  -> "db" is the service name in docker-compose,
# not "localhost": inside the Docker network, services resolve by name.
POSTGRES_DB=novus
POSTGRES_USER=novus
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery (used starting Phase 1) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# --- Google Gemini (used starting Phase 2) ---
GEMINI_API_KEY=

# --- Frontend (variables read by Vite; must start with VITE_) ---
# For local dev WITHOUT Nginx, leave this unset so the app defaults to the
# backend on :8000, or set it explicitly. The value below assumes an Nginx
# proxy (production) serving the API under the same origin.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost/api/v1

# --- Email & password reset (used starting ADR-0019) ---
# Dev defaults to the console backend: reset links are printed to the backend
# logs, so no SMTP is needed locally. In production set the SMTP backend and
# fill in the host/credentials below, or reset emails go nowhere.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Novus RA Intelligence <no-reply@novus.local>
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# Public URL of the SPA; password-reset links point back here (no trailing slash).
DJANGO_FRONTEND_BASE_URL=http://localhost:5173
# How long a reset link stays valid, in seconds (default 3600 = 1 hour).
# DJANGO_PASSWORD_RESET_TIMEOUT=3600
